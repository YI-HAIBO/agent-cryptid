(* =====================================================================
   E18: CryptoVerif machine-checking of the E9 provable-security reduction
   ---------------------------------------------------------------------
   面向密码顶刊（IEEE TDSC / TIFS）的「可证明安全」一节。

   与 E8（ProVerif, Dolev-Yao symbolic）互补：
     E8  = 协议逻辑正确性（authentication / correspondence）
   E18 = 计算模型下的归约可验证性（EUF-CMA reduction soundness）

   本模型验证 E9 的三个结构性引理（lemma），而非重证原语安全：
     Lemma 1 (enc injectivity):   enc 是确定性单射编码 ⇒ 无碰撞。
     Lemma 2 (conjunction):      混合档 accept 仅在两个签名分量同时通过后触发
                                  ⇒ 伪造混合凭证必先伪造其一。
     Lemma 3 (chain reduction):  委托链逐跳验签 ⇒ 伪造含未授权跳的链必先伪造某跳签名。

   语法：CryptoVerif 2.12（2026-11-04 真机修正版）。
     - 签名假设用 expand SUF_CMA_proba_signature（内置 EUF-CMA：check 仅对
       真实 sign 返回 true），而非手写 equation（手写不捕获不可伪造性）。
     - 混合档与委托链各用【独立】的 EUF-CMA 签名实例（sign_h/check_h 与
       sign_c/check_c，两套独立 expand）。若共用同一 sign/check，CryptoVerif
       的 SUF-CMA 展开会把 hybrid 的签名实例也放进 chain 校验端的 find 分支，
       导致「借 hybrid 有效签名触发 chain_hop_accepted 而无 chain_hop_issued」。
       分实例后 check_c 的 find 只匹配 sign_c 实例，跨域分支被结构性消除。
     - enc 为单射构造子（fun 无 [data]）⇒ CryptoVerif 自动证 injectivity。
     - 域分离：enc 第 6 参 domain ∈ {DOM_HYB, DOM_CHN} 再加一层标签（防跨域
       签名重放；与独立签名实例互为冗余防护）。
     - 事件按 correspondence 语义排序：verify 事件先于 accept 事件。
   运行：cryptoverif e18_cryptoverif_credential.pv
   预期：Lemma 1 / Lemma 2 为结构性 correspondence，可自动证；
         Lemma 3（消息级）需 SUF-CMA（独立实例）+ 域分离；enc 单射提升到跳元组。
   ===================================================================== *)

param N.

(* ------------------------------- 类型 ------------------------------- *)
type message.          (* 凭证字段：iss, sub, act, aud, scope, iat, nbf, exp, alg, nonce *)
type scope.            (* 权限集合（抽象项） *)
type nonce [large,fixed].  (* 一次性随机数 *)
type alg_tier.         (* 算法档位标签：sm2 / hybrid / hash-signature *)
type blocksize [fixed].    (* 待签名字节串（enc 的输出） *)
type domain.           (* 签名域标签：混合档 / 委托链（域分离） *)
const DOM_HYB: domain. (* 混合档签名域 *)
const DOM_CHN: domain. (* 委托链签名域 *)

(* ----------------------------- 密码函数 ----------------------------- *)
(* enc: 凭证消息 → 待签名字节串（确定性、单射、带域分离；alg 进入编码防降级）。
   作为普通构造子（无 [data]），CryptoVerif 自动视为单射 ⇒ Lemma 1。 *)
fun enc(message, message, scope, nonce, alg_tier, domain): blocksize.

(* scope 包含谓词：child ⊆ parent（未解释函数 = 任意包含检查） *)
fun scope_contains(scope, scope): bool.

(* --------------------- 签名假设（EUF-CMA，内置） --------------------- *)
proba Psign.
proba Psigncoll.

(* 混合档签名实例：SM2 / ML-DSA 两分量用同一实例建模（归约对原语无关）。 *)
type keyseed [large,fixed].
type pkey_h [bounded].
type skey_h [bounded].
type sig_h [bounded].
expand SUF_CMA_proba_signature(keyseed, pkey_h, skey_h, blocksize, sig_h,
       sskgen_h, spkgen_h, sign_h, check_h, Psign, Psigncoll).

(* 委托链签名实例：独立 EUF-CMA 实例（关键 —— 防止 hybrid 签名混入链校验 find）。 *)
type pkey_c [bounded].
type skey_c [bounded].
type sig_c [bounded].
expand SUF_CMA_proba_signature(keyseed, pkey_c, skey_c, blocksize, sig_c,
       sskgen_c, spkgen_c, sign_c, check_c, Psign, Psigncoll).

(* ------------------------------- 事件 ------------------------------- *)
(* Lemma 2 用：混合档接受 / 分量1通过 / 分量2通过 *)
event accept_hybrid(message, message, scope, nonce).
event comp1_verified(message, message, scope, nonce).
event comp2_verified(message, message, scope, nonce).
(* Lemma 3 用：链上某跳的签名消息被接受 / 该消息由委托方真实签发。
   事件以签名消息 m: blocksize 为参数：CryptoVerif 的 SUF-CMA find 直接把
   verifier 的 m1 与 issuer 的 m_i 绑定（m1 = m_i），无需 enc 单射桥接即可证。
   由 Lemma 1（enc 单射，构造子语义机器保证）可把消息级语句提升到跳元组级：
   m = enc(delegatee, deleg, sc, n, ALG, DOM_CHN) 唯一确定 (deleg, delegatee, sc, n)。 *)
event chain_hop_accepted(blocksize).
event chain_hop_issued(blocksize).

(* -------------------------- Lemma 1: enc injectivity -------------------------- *)
(* CryptoVerif 的 correspondence 查询要求左侧为事件（或事件合取），不允许
   等式左侧，因此 Lemma 1（enc 单射 ⟹ 无碰撞）不以查询形式编码。
   反之，enc 被声明为 fun 构造子（无 [data]），CryptoVerif 的构造子语义
   本身即保证单射：enc(x...) = enc(y...) 当且仅当 x... = y...，无碰撞。
   即 Lemma 1 由构造子语义机器保证（见上方 fun enc 声明）。 *)

(* ------------------------- Lemma 2: conjunction reduction ------------------------- *)
(* 混合档 accept_hybrid 仅在两个签名分量都通过后才触发。
   对应 E9 定理 2「Adv ≤ min(Adv_SM2, Adv_MLDSA)」的结构基础：
   伪造混合凭证 ⇒ 必先伪造其一。 *)
query forall sub:message, aud:message, sc:scope, n:nonce;
  event(accept_hybrid(sub, aud, sc, n)) ==> event(comp1_verified(sub, aud, sc, n)).
query forall sub:message, aud:message, sc:scope, n:nonce;
  event(accept_hybrid(sub, aud, sc, n)) ==> event(comp2_verified(sub, aud, sc, n)).

(* ------------------------- Lemma 3: chain reduction ------------------------- *)
(* 消息级 correspondence：接受某链跳签名消息 ⟹ 该消息由委托方真实签发。
   CryptoVerif 经 SUF-CMA find 直接绑定 m1 = m_i 证明；enc 单射（Lemma 1）
   把此提升为「伪造含未授权跳的链必先伪造某跳签名」。 *)
query forall m: blocksize;
  event(chain_hop_accepted(m)) ==> event(chain_hop_issued(m)).

(* ------------------------------- 进程 ------------------------------- *)
channel cPK, cReqIss, cReqVer, cCred, cDlReq, cDlOut, cDlIn, start.
const ALG: alg_tier.

(* ---- 混合档签发方：对 enc(sub,aud,scope,nonce,ALG,DOM_HYB) 双签 ---- *)
let hybrid_issuer(sk_h: skey_h) =
  in(cReqIss, (sub:message, aud:message, sc:scope, n:nonce));
  out(cCred, (sub, aud, sc, n,
              sign_h(enc(sub, aud, sc, n, ALG, DOM_HYB), sk_h),
              sign_h(enc(sub, aud, sc, n, ALG, DOM_HYB), sk_h))).

(* ---- 混合档校验端：双验签 ⇒ accept（事件按 correspondence 语义排序） ---- *)
let hybrid_verifier(pk_h: pkey_h) =
  in(cReqVer, (sub:message, aud:message, sc:scope, n:nonce, s1:sig_h, s2:sig_h));
  if check_h(enc(sub, aud, sc, n, ALG, DOM_HYB), pk_h, s1) then
    event comp1_verified(sub, aud, sc, n);
    if check_h(enc(sub, aud, sc, n, ALG, DOM_HYB), pk_h, s2) then
      event comp2_verified(sub, aud, sc, n);
      event accept_hybrid(sub, aud, sc, n)
    else yield
  else yield.

(* ---- 委托方：签发子凭证（scope 收敛） ---- *)
let chain_issuer(sk_c: skey_c) =
  in(cDlReq, (deleg:message, delegatee:message, sc:scope, psc:scope, n:nonce));
  if scope_contains(sc, psc) then
    let m = enc(delegatee, deleg, sc, n, ALG, DOM_CHN) in
    event chain_hop_issued(m);
    out(cDlOut, (deleg, delegatee, sc, n, sign_c(m, sk_c)))
  else yield.

(* ---- 链校验端：验签 ⇒ 接受 ---- *)
let chain_verifier(pk_c: pkey_c) =
  in(cDlIn, (deleg:message, delegatee:message, sc:scope, n:nonce, s:sig_c));
  let m1 = enc(delegatee, deleg, sc, n, ALG, DOM_CHN) in
  if check_c(m1, pk_c, s) then
    event chain_hop_accepted(m1)
  else yield.

process
  in(start, ());
  new rk_h: keyseed;
  new rk_c: keyseed;
  let pk_h = spkgen_h(rk_h) in
  let sk_h = sskgen_h(rk_h) in
  let pk_c = spkgen_c(rk_c) in
  let sk_c = sskgen_c(rk_c) in
  out(cPK, (pk_h, pk_c));
  ( (! i <= N hybrid_issuer(sk_h)) |
    (! i <= N hybrid_verifier(pk_h)) |
    (! i <= N chain_issuer(sk_c)) |
    (! i <= N chain_verifier(pk_c)) )

(* 说明：Lemma 1 依赖 enc 作为单射构造子；Lemma 2 为纯结构性 correspondence
   （accept_hybrid 仅在 comp1_verified 与 comp2_verified 之后触发）；
   Lemma 3 以签名消息 m 为事件参数，依赖独立 EUF-CMA 实例（check_c 仅对真实
   sign_c 返回 true，hybrid 签名不在链域 find 分支）+ 域分离；enc 单射（Lemma 1）
   再把消息级语句提升为「伪造含未授权跳的链必先伪造某跳签名」。 *)
