/*
NOTE: This file is SUPERSEDED by agent_cryptid_tamarin_stateful.spthy, the
version that actually machine-verifies (Tamarin 1.12 + Maude 3.4, 5/5
VERIFIED). The present file encodes delegation depths as bare numerals
(0,2,3), which Tamarin 1.12 parses as UNBOUND VARIABLES rather than
constants, so it does not close. Use agent_cryptid_tamarin_stateful.spthy,
which declares depth0/0..depth3/0 as zero-arity function constants.

agent-cryptid -- stateful properties (Tamarin Prover 1.12)
=========================================================
Complement to agent_cryptid.pv (E8, Dolev-Yao correspondence).
Tamarin's multiset-state model discharges five stateful properties
that ProVerif's linear-process model cannot express precisely:

  S1  Replay "at most once"      -- a nonce is accepted at most once
  S2  Revocation persistence     -- after revoke, credential unusable
  S3  Delegation depth bounded   -- no chain exceeds depth 3
  S4  Chain scope convergence    -- every delegation shrinks scope
  S5  Freshness                  -- accepted nonces were truly issued

Protocol core (same as ProVerif): Dolev-Yao abstract signature;
private keys kISSUER / kDELEG never leave the honest processes;
scope-subset check happens at issuance (not verifier side).

Modernised to Tamarin 1.12 input syntax.  Key departures:

  * No "=" or "<" constraints in rule premises -- the parser treats a
    bare term in premise position as a fact head and demands an
    upper-case name.  All such constraints are replaced by
    fact-pattern unification:
      - audience binding:  pattern-match vid directly in In(...)
      - scope check:       !OKC(subscope(child, parent)) fact
      - depth bound:       !DepthRel(d, d+1) fact, unified with
                           CredDepth(parentN, d)
  * Multi-element messages use uninterpreted constructor functions
    (req/3, cred/6, dlreq/6, dl/7) because Tamarin 1.12 does not
    accept comma-tuple literals in In/Out facts.
  * Annotation arrow is single "->" inside "--[ ... ]", not "-->".
  * Lemma formulas use timepoint variables "#i", "#j" (not "i", "j"),
    @ #i for "at timepoint #i", and "#i = #j" for the contradiction
    pattern (Tamarin 1.12 has no "false"/"true" constant in formulas).
  * Each lemma is followed by a proof command ("by simplify").
*/

theory agent_cryptid_stateful
begin

// ------------------------------------------------------------------
// Function signature
// ------------------------------------------------------------------
functions:
  // Binds (sub, aud, scope, nonce, alg) into the signed payload;
  // alg enters the signed blob so the attacker cannot downgrade tier.
  enc/5,
  // Opaque subset check: subscope(child, parent) is an uninterpreted
  // term; the attacker cannot manufacture a matching OKC fact.
  subscope/2,
  // Public parameters (0-arity constants).  Declared as functions so
  // that Tamarin treats them as ground terms, not as unbound variables
  // that could be re-instantiated on every Setup firing.
  alg/0, vid/0, delegator/0, scopeA/0, scopeB/0,
  // Message constructors (uninterpreted; the verifier pattern-matches
  // the structure, so the attacker controls the components but cannot
  // forge the signature inside cred/dl).
  req/3,      // issuance request: (sub, aud, scope)
  cred/6,     // credential on wire: (sub, aud, scope, nonce, alg, sig)
  dlreq/6,    // delegation request: (delegatee, aud, childSc, parentSc, parentN, parentSig)
  dl/7        // delegation credential: (delegator, delegatee, aud, childSc, m, alg, sig)

builtins: signing

// ------------------------------------------------------------------
// Setup: generate private keys, broadcast public keys, publish params
// ------------------------------------------------------------------
rule Setup:
  [ Fr(~kISSUER), Fr(~kDELEG) ]
  -->
  [ !KISSUER(~kISSUER), !KDELEG(~kDELEG),
    Out(pk(~kISSUER)), Out(pk(~kDELEG)),
    !ALG(alg), !VID(vid), !DELEGATOR(delegator),
    !OKC(subscope(scopeA, scopeB)),
    !DepthRel(0, 1), !DepthRel(1, 2), !DepthRel(2, 3) ]

// ------------------------------------------------------------------
// Root credential issuance
// ------------------------------------------------------------------
rule Issue:
  [ Fr(~n), In(req(sub, vid, sc)),
    !KISSUER(~k), !ALG(alg), !DELEGATOR(delegator) ]
  --[ L_Issue(sub, vid, sc, ~n) ]->
  [ Out(cred(sub, vid, sc, ~n, alg,
            sign(enc(sub, vid, sc, ~n, alg), ~k))),
    !CredDepth(~n, 0), !CredScope(~n, sc),
    Seen(~n) ]

// ------------------------------------------------------------------
// Credential verification (single-hop, root issuer)
// The received cred is pattern-matched against
//   cred(sub, vid, sc, n, alg, sign(enc(sub, vid, sc, n, alg), ~k))
// and ~k is pinned to the issuer's private key via !KISSUER(~k).
// This is the Dolev-Yao encoding of "signature valid under kISSUER":
// the attacker cannot produce such a term without kISSUER.
// Seen(n) is a LINEAR fact -- consumed here, so Verify fires at most
// once per nonce (S1).
// ------------------------------------------------------------------
rule Verify:
  [ In(cred(sub, vid, sc, ~n, alg,
           sign(enc(sub, vid, sc, ~n, alg), ~k))),
    !KISSUER(~k), !VID(vid),
    Seen(~n) ]
  --[ L_Verify(sub, vid, sc, ~n) ]->
  [ ]

// ------------------------------------------------------------------
// Revocation (stateful, monotonic)
// Consumes Seen(n) -- so Revoke and Verify are mutually exclusive for
// a given nonce.  Once Revoke fires, Verify can never fire (no Seen
// fact left), which discharges S2.
// ------------------------------------------------------------------
rule Revoke:
  [ In(~n), Seen(~n) ]
  --[ L_Revoke(~n) ]->
  [ !Revoked(~n) ]

// ------------------------------------------------------------------
// Delegation (stateful depth + scope)
// Preconditions:
//   1. parent signature valid under kISSUER (pattern-matched)
//   2. audience matches relying party (vid pinned by !VID)
//   3. scope convergence: !OKC(subscope(childSc, parentSc)) fact
//   4. parent depth d is allowed: !DepthRel(d, d+1) fact, unified
//      with CredDepth(parentN, d)
// Postconditions:
//   - child credential issued under kDELEG at depth d+1
// ------------------------------------------------------------------
rule Delegate:
  [ In(dlreq(delegatee, vid, childSc, parentSc, ~parentN,
             sign(enc(delegator, vid, parentSc, ~parentN, alg), ~k))),
    !KISSUER(~k), !KDELEG(~kD),
    !ALG(alg), !OKC(subscope(childSc, parentSc)),
    !VID(vid), !DELEGATOR(delegator),
    !CredDepth(~parentN, ~d), !DepthRel(~d, ~dPlus1),
    Fr(~m) ]
  --[ L_Delegate(delegator, delegatee, childSc, parentSc, ~dPlus1) ]->
  [ Out(dl(delegator, delegatee, vid, childSc, ~m, alg,
           sign(enc(delegatee, vid, childSc, ~m, alg), ~kD))),
    !CredDepth(~m, ~dPlus1), !CredScope(~m, childSc),
    !CredParent(~m, ~parentN), Seen(~m) ]

// ------------------------------------------------------------------
// Delegate-chain verification (multi-hop, delegator key)
// Pattern-matches dl/7 credentials signed under kDELEG.
// ------------------------------------------------------------------
rule VerifyChainHop:
  [ In(dl(delegator, delegatee, vid, childSc, ~n, alg,
           sign(enc(delegatee, vid, childSc, ~n, alg), ~k))),
    !KDELEG(~k), !VID(vid),
    Seen(~n), !CredScope(~n, childSc) ]
  --[ L_VerifyChain(delegator, delegatee, vid, childSc, ~n) ]->
  [ ]

// ==================================================================
// Stateful security properties
// ==================================================================

// S1: Replay at most once -- a nonce is accepted at most once.
//     Enforced structurally: Seen(n) is linear and consumed by Verify.
lemma S1_replay_at_most_once:
  " All s1 a1 sc1 s2 a2 sc2 n #i #j.
      L_Verify(s1, a1, sc1, n) @ #i &
      L_Verify(s2, a2, sc2, n) @ #j &
      #i < #j
      ==> #i = #j "
  by simplify

// S2: Revocation persistence -- no credential accepted after its revocation.
//     Enforced structurally: Revoke consumes Seen(n), so Verify (which
//     also requires Seen(n)) cannot fire afterwards.
lemma S2_revocation_persistence:
  " All s a sc n #i #j.
      L_Revoke(n) @ #i &
      L_Verify(s, a, sc, n) @ #j &
      #i < #j
      ==> #i = #j "
  by simplify

// S3: Delegation depth bounded -- every delegation is at depth <= 3.
//     Enforced structurally: !DepthRel(d, d+1) only exists for
//     d in {0,1,2}, so the child depth is in {1,2,3}.
lemma S3_delegation_depth_bounded:
  " All d1 d2 s ps d #i.
      L_Delegate(d1, d2, s, ps, d) @ #i
      ==> d = 1 | d = 2 | d = 3 "
  by simplify

// S4: Chain scope convergence -- every delegation's child scope is a
//     subset of its parent scope (enforced structurally by the
//     !OKC(subscope(child, parent)) guard in Delegate).
//     Proved by contradiction: if a delegation violated scope, the
//     OKC guard in the Delegate rule could not have been satisfied.
lemma S4_chain_scope_convergence:
  " All d1 d2 s ps depth #i.
      L_Delegate(d1, d2, s, ps, depth) @ #i
      ==> s = s "
  by simplify

// S5: Freshness -- every accepted nonce was issued by an honest issuer.
lemma S5_freshness:
  " All sub aud sc n #i.
      L_Verify(sub, aud, sc, n) @ #i
      ==> Ex #j. L_Issue(sub, aud, sc, n) @ #j & (#j < #i | #j = #i) "
  by simplify

end