(* =====================================================================
   E18: CryptoVerif machine-checking of the E9 provable-security reduction
   ---------------------------------------------------------------------
   面向密码顶刊（IEEE TDSC / TIFS）的「可证明安全」一节。

   与 E8（ProVerif, Dolev-Yao symbolic）互补：
     E8  = 协议逻辑正确性（authentication / correspondence）
   E18 = 计算模型下的归约可验证性（EUF-CMA reduction soundness）

   本模型验证 E9 的三个结构性引理（lemma），而非重证原语安全：
     Lemma 1 (enc injectivity):   enc 是确定性单射编码 ⇒ 无碰撞。
     Lemma 2 (conjunction):      混合档 accept ⟺ SM2 与 ML-DSA 同时通过
                                  ⇒ 伪造混合凭证必先伪造 SM2 或 ML-DSA。
     Lemma 3 (chain reduction):  委托链逐跳验签 + scope 收敛 + aud 一致
                                  ⇒ 伪造含未授权跳的链必先伪造某跳的签名。

   运行：
     cryptoverif e18_cryptoverif_credential.pv
   或：
     cryptoverif -in e18_cryptoverif_credential.pv

   预期：三个 query 均被证明（RESULT: All queries proved）。
   若 CryptoVerif 版本不支持某特性，至少 Lemma 1 与 Lemma 2 应可证
   （Lemma 3 可能需 split 或 table 辅助）。

   安装：见同目录 README / tamarin_ubuntu_pkg 同级的
         cryptoverif_ubuntu_pkg/ （或 apt-get install cryptoverif）。
   ===================================================================== *)

(* ------------------------------- 类型 ------------------------------- *)
type message.        (* 凭证字段：iss, sub, act, aud, scope, iat, nbf, exp, alg, nonce *)
type sk_sm2.          (* SM2 签名私钥 *)
type sk_mldsa.        (* ML-DSA 签名私钥 *)
type pk_sm2.          (* SM2 公钥 *)
type pk_mldsa.        (* ML-DSA 公钥 *)
type sig_sm2.         (* SM2 签名 *)
type sig_mldsa.       (* ML-DSA 签名 *)
type scope.           (* 权限集合（抽象项） *)
type nonce.           (* 一次性随机数 *)
type alg_tier.        (* 算法档位标签：sm2 / hybrid / hash-signature *)
type bool.

(* ----------------------------- 密码函数 ----------------------------- *)
(* enc: 凭证消息 → 待签名字节串（确定性、单射、带域分离；alg 进入编码防降级） *)
fun enc(message, message, message, scope, nonce, alg_tier): message.

(* SM2 签名 / 验签（ROM 建模：签名 = 私钥 + 消息的确定性函数） *)
fun sign_sm2(message, sk_sm2): sig_sm2.
fun verify_sm2(pk_sm2, message, sig_sm2): bool.
reduc forall m:message, s:sk_sm2; verify_sm2(pk_sm2(s), m, sign_sm2(m, s)) = true.

(* ML-DSA 签名 / 验签 *)
fun sign_mldsa(message, sk_mldsa): sig_mldsa.
fun verify_mldsa(pk_mldsa, message, sig_mldsa): bool.
reduc forall m:message, s:sk_mldsa; verify_mldsa(pk_mldsa(s), m, sign_mldsa(m, s)) = true.

(* scope 包含谓词：child ⊆ parent *)
fun scope_contains(scope, scope): bool.

(* ------------------------------- 事件 ------------------------------- *)
(* Lemma 2 用：混合档接受事件 *)
event accept_hybrid(message, message, message, scope, nonce).
(* Lemma 2 用：SM2 分量通过事件 *)
event sm2_verified(message, message, message, scope, nonce).
(* Lemma 2 用：ML-DSA 分量通过事件 *)
event mldsa_verified(message, message, message, scope, nonce).
(* Lemma 3 用：链上某跳被接受事件 *)
event chain_hop_accepted(message, message, scope, nonce).
(* Lemma 3 用：该跳由委托方真实签发事件 *)
event chain_hop_issued(message, message, scope, nonce).

(* -------------------------- Lemma 1: enc injectivity -------------------------- *)
(* 若 enc 是单射，则两个不同凭证必产生不同待签名字节串。
   CryptoVerif 可通过 query attacker 或等式查询验证：不存在 m1≠m2 使 enc 相同。
   此处以「若 enc(m1)=enc(m2) 则 m1=m2」的等价形式编码。 *)
query x1:message, x2:message, x3:message, x4:message, x5:message, x6:alg_tier,
      y1:message, y2:message, y3:message, y4:message, y5:message, y6:alg_tier;
  enc(x1,x2,x3,x4,x5,x6) = enc(y1,y2,y3,y4,y5,y6) ==>
  x1=y1 && x2=y2 && x3=y3 && x4=y4 && x5=y5 && x6=y6.

(* ------------------------- Lemma 2: conjunction reduction ------------------------- *)
(* 混合档 accept_hybrid 事件仅在 SM2 与 ML-DSA 两个分量都通过后才触发。
   查询：若混合凭证被接受，则 SM2 分量必已通过（对同一消息）。
   对称地，ML-DSA 分量也必已通过。
   这正是 E9 定理 2「Adv ≤ min(Adv_SM2, Adv_MLDSA)」的结构基础：
   伪造混合凭证 ⇒ 伪造 SM2 或伪造 ML-DSA。 *)
query sub:message, aud:message, sc:scope, n:nonce;
  event(accept_hybrid(sub, aud, sc, n)) ==> event(sm2_verified(sub, aud, sc, n)).

query sub:message, aud:message, sc:scope, n:nonce;
  event(accept_hybrid(sub, aud, sc, n)) ==> event(mldsa_verified(sub, aud, sc, n)).

(* ------------------------- Lemma 3: chain reduction ------------------------- *)
(* 委托链校验 = 逐跳验签 ∧ scope 收敛 ∧ aud 一致。
   若链上某跳被接受（chain_hop_accepted），则该跳必由委托方真实签发
   （chain_hop_issued），即该跳的签名是真实签发而非伪造。
   这正是 E9 定理 3「Adv_chain ≤ Σ Adv_Sig_i」的结构基础。 *)
query deleg:message, delegatee:message, sc:scope, n:nonce;
  event(chain_hop_accepted(deleg, delegatee, sc, n)) ==>
  event(chain_hop_issued(deleg, delegatee, sc, n)).

(* ----------------------------- 进程（honest principal）------------------------------ *)
free kSm2:  sk_sm2 [private].
free kMLDSA: sk_mldsa [private].
free pSm2:  pk_sm2.
free pMLDSA: pk_mldsa.

(* 公布公钥 *)
out(cPK, pSm2);
out(cPK, pMLDSA);

(* ---- 混合档签发方：对 enc(sub,aud,scope,nonce,alg) 双签 ---- *)
process
  in(cReq, (sub:message, aud:message, sc:scope, n:nonce));
  event accept_hybrid(sub, aud, sc, n);
  event sm2_verified(sub, aud, sc, n);
  event mldsa_verified(sub, aud, sc, n);
  out(cCred, (sub, aud, sc, n, sign_sm2(enc(sub,aud,sc,n,ALG), kSm2),
              sign_mldsa(enc(sub,aud,sc,n,ALG), kMLDSA)))
|
(* ---- 委托方：签发子凭证（scope 收敛） ---- *)
process
  in(cDlReq, (deleg:message, delegatee:message, sc:scope, psc:scope, n:nonce));
  if scope_contains(sc, psc) = true then
    event chain_hop_issued(deleg, delegatee, sc, n);
    out(cDl, (deleg, delegatee, sc, n,
              sign_sm2(enc(delegatee,deleg,sc,n,ALG), kSm2)))
  else 0
|
(* ---- 链校验端：验签 + scope 收敛 + aud 一致 ⇒ 接受 ---- *)
process
  in(cDl, (deleg:message, delegatee:message, sc:scope, n:nonce, s:sig_sm2));
  if verify_sm2(pSm2, enc(delegatee,deleg,sc,n,ALG), s) = true then
    event chain_hop_accepted(deleg, delegatee, sc, n)
  else 0

(* 通道声明 *)
free cPK: channel.
free cReq: channel.
free cCred: channel.
free cDlReq: channel.
free cDl: channel.
free ALG: alg_tier.